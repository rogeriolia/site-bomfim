# API do site público — apenas /opt/site-bomfim (repo site-bomfim).
# Não instalar em /opt/bomfim. Não alterar units do app legado em /opt/bomfim.
#
#   sudo cp deploy/systemd/bomfim-site-api.service.example /etc/systemd/system/bomfim-site-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bomfim-site-api

[Unit]
Description=Bomfim site publico — API FastAPI (site-bomfim)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/site-bomfim
EnvironmentFile=-/opt/site-bomfim/.env
ExecStart=/opt/site-bomfim/.venv/bin/python run.py --api-only --host 127.0.0.1 --port 5183
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target