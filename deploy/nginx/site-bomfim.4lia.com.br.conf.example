# Site estático em /opt/site-bomfim (base Vite /site-bomfim/) + API em 127.0.0.1:5183
#   sudo cp deploy/nginx/site-bomfim.4lia.com.br.conf.example /etc/nginx/sites-available/site-bomfim.4lia.com.br
#   sudo nginx -t && sudo systemctl reload nginx
#
# URL: https://site-bomfim.4lia.com.br/site-bomfim/
# www.4lia.com.br/site-bomfim/ fica na KingHost — copie dist/ para lá ou aponte DNS conforme sua infra.

server {
    listen 80;
    listen [::]:80;
    server_name site-bomfim.4lia.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name site-bomfim.4lia.com.br;

    ssl_certificate /etc/letsencrypt/live/site-bomfim.4lia.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/site-bomfim.4lia.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = / {
        return 302 /site-bomfim/;
    }

    location ^~ /site-bomfim/api/ {
        proxy_pass http://127.0.0.1:5183/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /site-bomfim/ {
        alias /opt/site-bomfim/dist/;
        index index.html;
    }

    location ^~ /site-bomfim/assets/ {
        alias /opt/site-bomfim/dist/assets/;
        expires 7d;
    }

    location ^~ /site-bomfim/galeria-equipe/ {
        alias /opt/site-bomfim/dist/galeria-equipe/;
        try_files $uri $uri/ /site-bomfim/galeria-equipe/index.html;
    }

    location ^~ /site-bomfim/revisao-editorial/ {
        alias /opt/site-bomfim/dist/revisao-editorial/;
        try_files $uri $uri/ /site-bomfim/revisao-editorial/index.html;
    }

    location /site-bomfim/ {
        alias /opt/site-bomfim/dist/;
        try_files $uri $uri/ =404;
    }

    location = /site-bomfim {
        return 301 /site-bomfim/;
    }
}