# Copy to .env or .env.bomfim (never commit real credentials).
# Load automatically when running python run.py.

# PostgreSQL (schema in api/schema.sql)
BOMFIM_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bomfim_analytics

# Brevo transactional email
BOMFIM_BREVO_API_KEY=
BOMFIM_FROM_EMAIL=
BOMFIM_FROM_NAME=Bomfim Cargas
BOMFIM_LEADS_EMAIL=apolo@4lia.com.br
BOMFIM_TEST_EMAIL=apolo+cliente@4lia.com.br

# Allowed browser Origin (production site URL). Leave empty in local dev if Vite and API share the proxy.
BOMFIM_SITE_ORIGIN=https://www.4lia.com.br

# Optional overrides for run.py / servidor (/opt/site-bomfim apenas)
# BOMFIM_API_HOST=0.0.0.0
# BOMFIM_API_PORT=5183
# BOMFIM_SYSTEMD_SERVICE=bomfim-site-api